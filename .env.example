# Discord webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Discord user ID to tag when a match is found
DISCORD_USER_ID=123456789012345678

# How often to poll in seconds
POLL_INTERVAL_SECONDS=300

